generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id         String   @id @default(cuid())
  nom        String
  prenom     String
  email      String   @unique
  pseudo     String?
  imageUrl   String?
  password   String
  role       String   @default("ETUDIANT")
  pays       String?
  universite String?
  faculte    String?
  anneeEtude Int?
  statut     String   @default("EN_ATTENTE")
  onboardingCompleted Boolean @default(false)
  xp         Int      @default(0)
  streak     Int      @default(0)
  lives      Int      @default(5)
  chestAvailable Boolean @default(false)
  lastLifeLostAt DateTime?
  lastDailyRewardClaimedAt DateTime?
  isPremium Boolean   @default(false)
  premiumTier Int?
  premiumExpiresAt DateTime?
  lastActive DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
    attempts   Attempt[]
  badges     UserBadge[]
  premiumRequests PremiumRequest[]
  notifications Notification[]
  ambassadorCommissions AmbassadorCommission[] @relation("CommissionPayer")
  dailySelections DailyCaseSelection[]
  // ===== Espace monétisé (UA) =====
  uaBalance          Int       @default(0)
  uaLocked           Int       @default(0)
  uaRecharged        Int       @default(0) // part du solde issue de recharges (non retirable)
  seasonResults      SeasonResult[]
  tournamentEntries  TournamentEntry[]
  passActive         Boolean   @default(false)
  passExpiresAt      DateTime?
  streakBeforeReset  Int       @default(0)
  flameProtectedUntil DateTime?
  flameLostAt        DateTime?
  activeTitleId      String?
  activeFrameId      String?
  activeThemeId      String?
  uaTransactions     UaTransaction[]
  passRequests       PassRequest[]
  monetiseSelections MonetiseSelection[]
  monetiseAttempts   MonetiseAttempt[]
  rushSessions       RushSession[]
  withdrawals        WithdrawalRequest[]
  rechargeRequests   RechargeRequest[]
  inventory          UserInventory[]
  pushSubscription Json?
  duelsWon    Int @default(0)
  duelsLost   Int @default(0)
  pointsArena Int @default(0)
  duelsRequested    Duel[] @relation("DuelRequester")
  duelsOpposed      Duel[] @relation("DuelOpponent")
  arenaRewardClaims ArenaRewardClaim[]
  referredById   String?
  referredBy     Ambassador? @relation("ReferredBy", fields: [referredById], references: [id], onDelete: SetNull)
  ambassadorProfile Ambassador? @relation("AmbassadorUser")
  // ===== Amitiés & messagerie privée =====
  friendshipsRequested  Friendship[] @relation("FriendRequester")
  friendshipsReceived   Friendship[] @relation("FriendAddressee")
  messagesSent          DirectMessage[] @relation("MessageSender")
  messagesReceived      DirectMessage[] @relation("MessageRecipient")
}

model Friendship {
  id           String    @id @default(cuid())
  requesterId  String
  requester    User      @relation("FriendRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  addresseeId  String
  addressee    User      @relation("FriendAddressee", fields: [addresseeId], references: [id], onDelete: Cascade)
  status       String    @default("EN_ATTENTE") // EN_ATTENTE | ACCEPTE | REFUSE
  createdAt    DateTime  @default(now())
  respondedAt  DateTime?

  @@unique([requesterId, addresseeId])
}

model DirectMessage {
  id          String   @id @default(cuid())
  senderId    String
  sender      User     @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User     @relation("MessageRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  message     String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Subject {
  id         String   @id @default(cuid())
  name       String
  anneeEtude Int
  chapters   Chapter[]
  createdAt  DateTime @default(now())
}

model Chapter {
  id         String   @id @default(cuid())
  name       String
  subjectId  String
  subject    Subject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  cases      ClinicalCase[]
  createdAt  DateTime @default(now())
}

model ClinicalCase {
  id            String   @id @default(cuid())
  title         String
  difficulty    String
  xp            Int
  statement     String
  options       String[]
  correctAnswer String
  explanation   String
  durationMax   Int
  anneeEtude    Int      @default(1)
  chapterId     String
  chapter       Chapter  @relation(fields: [chapterId], references: [id], onDelete: Cascade)
  attempts      Attempt[]
  monetiseAttempts MonetiseAttempt[]
  createdAt     DateTime @default(now())
}

model Attempt {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicalCaseId String
  clinicalCase ClinicalCase @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  userAnswer   String
  isCorrect    Boolean
  timeSpent    Int
  xpEarned     Int
  createdAt    DateTime @default(now())
}

model Badge {
  id          String   @id @default(cuid())
  name        String
  description String
  icon        String
  users       UserBadge[]
}

model UserBadge {
  userId  String
  badgeId String
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge   Badge  @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  earnedAt DateTime @default(now())

  @@id([userId, badgeId])
}
model PremiumRequest {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptUrl      String
  tier            Int? // plan demandé : 1, 2 ou 3
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  commissions     AmbassadorCommission[]
  amount          Int? // montant payé (snapshot du prix du tier au moment de la demande)
  status          String   @default("EN_ATTENTE") // EN_ATTENTE, VALIDE, REJETE, REMBOURSE
  validatedAt     DateTime? // date d'encaissement confirmé (remplie par la validation admin)
  refundedAt      DateTime? // date de remboursement éventuel
  createdAt       DateTime @default(now())
}
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  message   String
  icon      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}
model Duel {
  id                 String    @id @default(cuid())
  requesterId        String
  requester          User      @relation("DuelRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  opponentId         String
  opponent           User      @relation("DuelOpponent", fields: [opponentId], references: [id], onDelete: Cascade)
  anneeEtude         Int
  caseIds            String[]
  status             String    @default("EN_ATTENTE") // EN_ATTENTE, ACCEPTE, TERMINE, REFUSE, EXPIRE
  winnerId           String?
  requesterAnswers   Json?
  opponentAnswers    Json?
  requesterScore     Int?
  opponentScore      Int?
  requesterTime      Int?
  opponentTime       Int?
  requesterCompleted Boolean   @default(false)
  opponentCompleted  Boolean   @default(false)
  requesterCompletedAt DateTime? // date de fin du joueur 1 (3e critère anti-égalité)
  opponentCompletedAt  DateTime? // date de fin du joueur 2
  expiresAt          DateTime
  playDeadline       DateTime?
  acceptedAt         DateTime?
  finalizedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model ArenaRewardClaim {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  threshold Int
  xpGranted Int
  claimedAt DateTime @default(now())

  @@unique([userId, threshold])
}
model PaymentMethod {
  id                String   @id @default(cuid())
  name              String   @unique
  isActive          Boolean  @default(false)
  isManual          Boolean  @default(true)
  beneficiaryName   String?
  paymentIdentifier String?
  instructions      String?
  icon              String?
  displayOrder      Int      @default(99)
  provider          String?
  premiumRequests   PremiumRequest[]
  passRequests      PassRequest[]
  rechargeRequests  RechargeRequest[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Expense {
  id          String   @id @default(cuid())
  amount      Int      // en FCFA
  category    String   // DEVELOPPEMENT, INFRASTRUCTURE, MARKETING, PUBLICITE, OUTILS_IA, RECOMPENSES, COMMISSIONS, MAINTENANCE, DOMAINE, AUTRE
  description String?
  vendor      String?  // fournisseur
  spentAt     DateTime // date réelle de la dépense
  createdAt   DateTime @default(now())
}

model FinancialGoal {
  id        String   @id @default(cuid())
  type      String   // CA_MENSUEL | PREMIUM_ACTIFS | MRR | RESULTAT_ESTIME
  target    Int
  period    String   // "2026-01" (mensuel) | "2026" (annuel)
  createdAt DateTime @default(now())
}
model Ambassador {
  id             String   @id @default(cuid())
  userId         String   @unique
  user           User     @relation("AmbassadorUser", fields: [userId], references: [id], onDelete: Cascade)
  referralCode   String   @unique
  status         String   @default("EN_ATTENTE") // EN_ATTENTE | ACTIF | SUSPENDU
  commissionRate Int      @default(10) // % appliqué aux paiements de ses référés
  country        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  commissions    AmbassadorCommission[]
  payouts        AmbassadorPayout[]
  referredUsers  User[]   @relation("ReferredBy")
}

model AmbassadorCommission {
  id                String   @id @default(cuid())
  ambassadorId      String
  ambassador        Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  premiumRequestId  String   @unique // ANTI-DOUBLON : une commission par transaction, impossible d'en créer deux
  premiumRequest    PremiumRequest @relation(fields: [premiumRequestId], references: [id], onDelete: Cascade)
  userId            String
  user              User     @relation("CommissionPayer", fields: [userId], references: [id], onDelete: Cascade)
  amount            Int      // montant de la commission (calculé à la création, figé)
  status            String   @default("EN_ATTENTE") // EN_ATTENTE | PAYEE | ANNULEE
  paidAt            DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model AmbassadorPayout {
  id           String   @id @default(cuid())
  ambassadorId String
  ambassador   Ambassador @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  amount       Int      // montant total versé
  note         String?  // référence de versement
  paidAt       DateTime
  createdAt    DateTime @default(now())
}
model DailyCaseSelection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime // le jour (à minuit)
  caseIds   String[] // les 10 cas du jour de CET étudiant
  createdAt DateTime @default(now())

  @@unique([userId, date]) // une seule sélection par étudiant et par jour
}
model UaTransaction {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // CAS_REUSSI | RUSH_PALIER_1/2/3 | RUSH_COFFRE | PASS_RENOUVELLEMENT | ACHAT_BOUTIQUE | TICKET_RUSH | RETRAIT_BLOCAGE | RETRAIT_PAYE | RETRAIT_REJET | RETRAIT_ANNUL | ADMIN_CORRECTION
  amount        Int      // positif = crédit, négatif = débit
  balanceBefore Int
  balanceAfter  Int
  rechargedDelta Int     @default(0) // variation de User.uaRecharged pour cette ligne (audit)
  reference     String?  // clinicalCaseId, rushSessionId, itemId...
  createdAt     DateTime @default(now())
}

model RushSession {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekend       String    // "2026-W03" (année-semaine ISO)
  attemptNumber Int
  wasFree       Boolean
  errors        Int       @default(0)
  currentStreak Int       @default(0)
  playedCaseIds String[] @default([])
  palier1       Boolean   @default(false)
  palier2       Boolean   @default(false)
  palier3       Boolean   @default(false)
  status        String    @default("EN_COURS") // EN_COURS | TERMINE_ECHEC | TERMINE_PLAFOND | TERMINE_ABANDON
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
}

model WithdrawalRequest {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUA    Int
  amountFCFA  Int
  operator    String    // ORANGE_MONEY | MOOV_MONEY
  phoneNumber String
  accountName String?
  status      String    @default("EN_ATTENTE") // EN_ATTENTE | EN_TRAITEMENT | PAYE | REJETE | ANNULE
  note        String?
  processedAt DateTime?
  createdAt   DateTime  @default(now())
}

model ShopItem {
  id          String          @id @default(cuid())
  category    String          // FLAMME | RUSH | THEME | CADRE | TITRE | EFFET | COFFRE
  name        String
  description String?
  icon        String?
  priceUA     Int
  effectKey   String?
  payload     Json?
  isActive    Boolean         @default(true)
  inventory   UserInventory[]
}

model UserInventory {
  userId      String    @default(cuid())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  itemId      String
  item        ShopItem  @relation(fields: [itemId], references: [id], onDelete: Cascade)
  quantity    Int       @default(1)
  purchasedAt DateTime  @default(now())

  @@unique([userId, itemId])
}
model PassRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  receiptUrl      String    // chemin Supabase Storage (bucket receipts)
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  status          String    @default("EN_ATTENTE") // EN_ATTENTE | VALIDE | REJETE
  createdAt       DateTime  @default(now())
  validatedAt     DateTime?
}
model MonetiseSelection {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime
  caseIds   String[]
  createdAt DateTime @default(now())

  @@unique([userId, date])
}

model MonetiseAttempt {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicalCaseId String
  clinicalCase   ClinicalCase @relation(fields: [clinicalCaseId], references: [id], onDelete: Cascade)
  userAnswer     String
  isCorrect      Boolean
  timeSpent      Int
  createdAt      DateTime @default(now())
}
model RechargeRequest {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  amountUA        Int
  amountFCFA      Int
  paymentMethodId String?
  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id], onDelete: SetNull)
  receiptUrl      String
  status          String    @default("EN_ATTENTE") // EN_ATTENTE | VALIDE | REJETE
  note            String?
  validatedAt     DateTime?
  createdAt       DateTime  @default(now())
}

// Résultat d'une saison mensuelle (créé à la clôture du mois dans le panel admin, puis les XP repartent à zéro)
model SeasonResult {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  season     String   // "2026-10"
  xp         Int
  gradeIndex Int      // 0 à 7 (voir src/lib/grades.ts)
  rank       Int      // classement final du mois
  createdAt  DateTime @default(now())

  @@unique([userId, season])
  @@index([season])
}


// ===== TOURNOI MENSUEL : les 10 premiers de chaque promotion jouent 20 cas inédits sur 48 h =====
model Tournament {
  id         String   @id @default(cuid())
  season     String   // mois dont sont issus les finalistes, ex. "2026-10"
  anneeEtude Int      // promotion (1 à 7)
  title      String
  status     String   @default("BROUILLON") // BROUILLON | PUBLIE | TERMINE
  caseIds    String[] @default([])         // les 20 cas inédits, dans l'ordre
  opensAt    DateTime
  closesAt   DateTime
  prize      String?
  createdAt  DateTime @default(now())
  entries    TournamentEntry[]

  @@unique([season, anneeEtude])
}

model TournamentEntry {
  id            String     @id @default(cuid())
  tournamentId  String
  tournament    Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  seed          Int        // rang de qualification (1 = premier du mois)
  currentIndex  Int        @default(0)
  caseStartedAt DateTime?  // heure de départ du cas en cours (le chrono est mesuré par le serveur)
  startedAt     DateTime?
  finishedAt    DateTime?
  score         Int        @default(0)
  totalTime     Int        @default(0) // secondes (départage les égalités)
  answers       Json       @default("[]")
  rank          Int?       // rang final, renseigné à la clôture

  @@unique([tournamentId, userId])
  @@index([userId])
}
